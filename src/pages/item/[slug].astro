---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import CopyLink from '../../components/CopyLink.astro';
import { getEntry, getShelves, fmtDate, renderBody, mentionsHtml } from '../../lib/items.js';
import { inShelf } from '../../lib/sorting.js';
import { TYPES, STATUS_LABEL, DETAIL_LABELS, HIDDEN_DETAILS, formatDetail, stars, progressOf } from '../../lib/types.js';
import { itemComments } from '../../../server/federation/index.js';
import { threadHtml } from '../../scripts/friends-ui.js';
import '../../styles/friends.css';

const env = Astro.locals.runtime.env;
const slug = Astro.params.slug || '';
const entry = /^[a-z0-9][a-z0-9-]{0,120}$/.test(slug) ? await getEntry(env, slug) : null;
if (!entry) return new Response(null, { status: 404, statusText: 'Not found' });
const d = entry.data;
const t = TYPES[d.type] || TYPES.book;
const bodyHtml = mentionsHtml(renderBody(entry.body));
const shelves = (await getShelves(env)).filter((s) => inShelf(d, s));
const details = Object.entries(d.details || {})
  .filter(([k]) => !HIDDEN_DETAILS.has(k))
  .map(([k, v]) => [DETAIL_LABELS[k] || k, formatDetail(k, v, d.details)])
  .filter(([, v]) => v);
const hasBody = Boolean(bodyHtml);
// Only Finished entries show a finished date (an old one can linger after the status changed).
const finished = d.status === 'finished' ? d.dateFinished : null;
const thoughtsDate = finished || d.dateStarted || d.dateAdded;
// YouTube videos play right on the page (the privacy-enhanced player, no cookies until you press play).
const ytVideoId = d.type === 'video' ? (String(d.source?.id || '').match(/^video:([A-Za-z0-9_-]{11})$/) || [])[1] || '' : '';
const progress = progressOf(d);
const expansions = d.type === 'boardgame' && Array.isArray(d.expansions) ? d.expansions : [];
// Comments from friends (and your replies). Visitors see them; signed in, you can reply and delete.
let comments = [];
try { comments = await itemComments(env, Astro.url.href, slug); } catch {}
---
<Base title={d.title} description={d.description}>
  <a class="back-link" id="back-link" href={`/type/${d.type}/`} data-fallback={`/type/${d.type}/`}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <span>Back</span>
  </a>
  <article class="item-page">
    <div class="item-cover">
      {ytVideoId ? (
        <div class="yt-embed">
          <iframe src={`https://www.youtube-nocookie.com/embed/${ytVideoId}`} title={`${d.title} (YouTube video)`} loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
      ) : (
        <Cover item={d} height={d.type === 'music' || d.type === 'boardgame' || d.type === 'video' ? 300 : 360} link={false} eager />
      )}
    </div>
    <div class="item-info">
      <p class="eyebrow"><a href={`/type/${d.type}/`}>{t.label}</a>{d.year && <> · {d.year}</>}</p>
      <h1>{d.title}<CopyLink /></h1>

      {hasBody && (
        <section class="my-thoughts-card">
          <p class="eyebrow">{t.label} · {STATUS_LABEL(d.type, d.status)}{thoughtsDate && <> · {fmtDate(thoughtsDate)}</>}</p>
          <h2>My thoughts {d.rating != null && <span class="rating">{stars(d.rating)}</span>}</h2>
          <div class="prose" set:html={bodyHtml} />
        </section>
      )}

      {d.creator && <p class="creator">{t.creator}: {d.creator}</p>}

      <div class="item-meta">
        <span class:list={['status', `status-${d.status}`]}>{STATUS_LABEL(d.type, d.status)}</span>
        {d.rating != null && !hasBody && <span class="rating" aria-label={`${d.rating} out of 5`}>{stars(d.rating)}</span>}
      </div>

      {progress && (
        <div class="item-progress">
          <span class="item-progress-text">{progress.text}{progress.pct != null && <> · {progress.pct}%</>}</span>
          {progress.pct != null && <span class="item-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={progress.pct} aria-label={progress.text}><span style={`width:${progress.pct}%`}></span></span>}
        </div>
      )}

      {/* Shown by the script below, only to you (signed in on this browser). */}
      <div class="item-actions" id="item-actions" hidden>
        <button type="button" class="item-action" data-rec-slug={entry.id} data-rec-title={d.title}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/></svg>
          Recommend to a friend
        </button>
      </div>

      <dl class="facts">
        {d.dateStarted && <><dt>Started</dt><dd>{fmtDate(d.dateStarted)}</dd></>}
        {finished && <><dt>Finished</dt><dd>{fmtDate(finished)}</dd></>}
        {details.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
        {d.genres?.length > 0 && <><dt>Genres</dt><dd>{d.genres.join(', ')}</dd></>}
      </dl>

      {(shelves.length > 0 || d.tags?.length > 0) && (
        <div class="chips">
          {shelves.map((s) => <a class="chip" href={`/shelf/${s.slug}/`}>{s.name}</a>)}
          {d.tags?.map((tag) => <span class="chip chip-tag">#{tag}</span>)}
        </div>
      )}

      {expansions.length > 0 && (
        <section class="expansions-section">
          <h2>Expansions <span class="count">{expansions.length}</span></h2>
          <ul class="expansion-grid">
            {expansions.map((x) => {
              const Tag = x.url ? 'a' : 'div';
              return (
                <li>
                  <Tag class="expansion" href={x.url || undefined} target={x.url ? '_blank' : undefined} rel={x.url ? 'noopener' : undefined}>
                    <span class="expansion-img">
                      {x.cover
                        ? <img src={x.cover} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.parentElement.classList.add('broken');this.remove();" />
                        : null}
                      <span class="expansion-ph" aria-hidden="true">{x.title.slice(0, 1)}</span>
                    </span>
                    <span class="expansion-title">{x.title}</span>
                    {x.year && <span class="expansion-year">{x.year}</span>}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </section>
      )}


      <section class="comments-section" id="comments" hidden={comments.length === 0}>
        <h2>Comments</h2>
        <Fragment set:html={threadHtml(comments, { ownSlug: slug, open: true })} />
      </section>

      {d.description && (
        <section class="synopsis">
          <h2>About</h2>
          <p>{d.description}</p>
        </section>
      )}

      <p class="item-foot">
        {d.source?.url && <a href={d.source.url} rel="noopener" target="_blank">View on {d.source.name}</a>}
        <a class="quiet" href={`/admin/#edit=${entry.id}`}>Edit</a>
      </p>
    </div>
  </article>
  <p class="fr-toast" id="fr-toast" role="status" hidden></p>
</Base>

<script>
  // Comments: signed in on this browser, you can reply and delete (the section shows even when it's empty).
  import { token, api, bindThreads, setNicknames } from '../../scripts/friends-ui.js';
  import { enableMentionPicker } from '../../scripts/mention-picker.js';
  enableMentionPicker();
  const section = document.getElementById('comments');
  const toastEl = document.getElementById('fr-toast');
  let toastTimer;
  const say = (msg, kind = 'ok') => {
    toastEl.textContent = msg;
    toastEl.classList.toggle('error', kind === 'error');
    toastEl.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => (toastEl.hidden = true), 6000);
  };
  import { bindRecommendButtons } from '../../scripts/recommend-dialog.js';
  bindRecommendButtons(document.getElementById('item-actions'));
  if (token()) api('ping').then(() => { document.getElementById('item-actions').hidden = false; }).catch(() => {});
  if (section && token()) {
    api('ping').then(() => {
      section.hidden = false;
      // Your private nicknames for friends, on their comments (only you see them).
      api('friends?nicknames=1').then(({ nicknames }) => setNicknames(nicknames, section)).catch(() => {});
      bindThreads(section, { me: location.origin, toast: say });
      if (location.hash === '#comments') section.scrollIntoView({ block: 'start' });
    }).catch(() => bindThreads(section, { toast: say }));
  } else if (section) {
    bindThreads(section, { toast: say });
  }

  // Go back to wherever the item was opened from (keeps that page's scroll position).
  // Opened directly (shared link, new tab)? Fall back to this item's media page.
  const back = document.getElementById('back-link');
  const cameFromSite = (() => {
    try { return document.referrer && new URL(document.referrer).origin === location.origin; } catch { return false; }
  })();
  if (back && cameFromSite && history.length > 1) {
    back.addEventListener('click', (e) => {
      e.preventDefault();
      history.back();
    });
  }
</script>

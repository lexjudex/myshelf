---
import Base from '../../layouts/Base.astro';
import { TYPES, TYPE_KEYS } from '../../lib/types.js';
import { ACCENTS, DEFAULT_ACCENT } from '../../../server/site.js';
import '../../styles/admin.css';
import '../../styles/decor.css';
export const prerender = true;
const typesJson = JSON.stringify(TYPES);
---
<Base title="Manage" noindex>
  <!-- ?embed=1: only the item editor, shown in a frame over a public shelf. Set before anything draws. -->
  <script is:inline>if (new URLSearchParams(location.search).has('embed')) document.documentElement.classList.add('embed');</script>
  <div id="admin" class="admin" data-types={typesJson}>
    <!-- Login -->
    <section id="login" class="panel" hidden>
      <h1>Manage your shelf</h1>
      <p class="muted">Enter the <code>ADMIN_TOKEN</code> you set in Cloudflare. It's stored only in this browser.</p>
      <form id="login-form" class="row">
        <input id="login-token" type="password" placeholder="Admin token" autocomplete="current-password" required />
        <button class="btn primary" type="submit">Unlock</button>
      </form>
      <p id="login-error" class="error" hidden></p>
    </section>

    <!-- App -->
    <section id="app" hidden>
      <div class="admin-top">
        <nav class="tabs" role="tablist">
          <button class="tab active" data-tab="add">＋ Add</button>
          <button class="tab" data-tab="library">Library</button>
          <button class="tab" data-tab="collections">Collections</button>
          <button class="tab" data-tab="friends">Friends <span id="friends-unread" class="tab-count" hidden></span></button>
          <button class="tab" data-tab="settings">Settings</button>
        </nav>
        <div class="admin-status">
          <span id="config-status"></span>
          <button id="logout" class="btn ghost small">Lock</button>
        </div>
      </div>

      <div id="storage-banner" class="storage-banner" hidden></div>
      <!-- A newer MyShelf is out, and announcements from the project (src/scripts/update-banner.js) -->
      <div id="update-banner" class="update-banner" role="region" aria-label="MyShelf updates" hidden></div>

      <!-- First sign-in on a new site (no collections yet): offer the starter shelves. -->
      <div id="starter-welcome" class="panel starter-welcome" hidden>
        <h2>Start your Shelves page</h2>
        <p class="muted">Your Shelves page shows your collections, and you don’t have any yet. Add these ready-made shelves? They fill themselves as you set statuses and ratings. You can rename, reorder or remove them any time in <strong>Collections</strong>.</p>
        <div class="starter-picks" data-starter-picks="welcome"></div>
        <div class="row">
          <button id="starter-add" class="btn primary" type="button">Add these shelves</button>
          <button id="starter-skip" class="btn ghost" type="button">No thanks</button>
        </div>
      </div>

      <!-- Add / search -->
      <div class="tabpanel" data-panel="add">
        <div class="panel">
          <div id="adding-to" class="adding-to" hidden></div>
          <div class="type-picker" id="type-picker">
            {TYPE_KEYS.map((t, i) => (
              <button type="button" class:list={['type-btn', { active: i === 0 }]} data-type={t}>{TYPES[t].label}</button>
            ))}
          </div>
          <form id="search-form" class="row">
            <input id="search-q" type="search" placeholder="Search books…" autocomplete="off" required minlength="2" />
            <button class="btn primary" type="submit">Search</button>
            <button class="btn ghost" type="button" id="manual-add">Add manually</button>
          </form>
          <form id="link-form" class="row link-form" hidden>
            <input id="link-url" type="text" inputmode="url" spellcheck="false" placeholder="Can't find it? Paste a BoardGameGeek link…" autocomplete="off" />
            <button class="btn ghost" type="submit">Look up</button>
          </form>
          <p id="search-msg" class="muted"></p>
          <div id="results" class="results"></div>
        </div>
      </div>

      <!-- Library -->
      <div class="tabpanel" data-panel="library" hidden>
        <div class="panel">
          <div class="row">
            <input id="lib-filter" type="search" placeholder="Filter by title or creator…" />
            <select id="lib-type">
              <option value="">All types</option>
              {TYPE_KEYS.map((t) => <option value={t}>{TYPES[t].plural}</option>)}
            </select>
          </div>
          <div class="row">
            <button id="refresh-bgg" class="btn ghost small" type="button">↻ Refresh board games from BGG</button>
            <button id="export-btn" class="btn ghost small" type="button" title="Download everything (items, notes, collections) as a JSON file">⤓ Download backup</button>
            <span id="refresh-bgg-msg" class="muted small"></span>
          </div>
          <ul id="lib-list" class="lib-list"></ul>
          <nav id="lib-pager" class="pager" aria-label="Library pages" hidden></nav>
        </div>
      </div>

      <!-- Collections -->
      <div class="tabpanel" data-panel="collections" hidden>
        <div class="panel">
          <h2>Collections</h2>
          <p class="muted">Each collection becomes a shelf, in this order. <em>Show on</em> picks where it appears: the Shelves page, the media pages (showing only that page’s type, e.g. its board games on Board Games), or both. Drag the <span aria-hidden="true">⠿</span> handle to change the order collections appear in, then save. Choose <em>Custom</em> sorting to drag items into your own order.</p>
          <div class="starter-box">
            <h3>Starter shelves</h3>
            <p class="muted small">Tick one to add it to the front of your Shelves page, already set up. Untick to remove it.</p>
            <div class="starter-picks" data-starter-picks="settings"></div>
          </div>
          <ul id="col-list" class="col-list"></ul>
          <div class="row">
            <button id="col-add" class="btn ghost" type="button">＋ New collection</button>
            <button id="col-save" class="btn primary" type="button">Save collections</button>
          </div>
        </div>
      </div>

      <!-- Friends -->
      <div class="tabpanel" data-panel="friends" hidden>
        <div class="panel">
          <h2>Friends</h2>
          <p class="muted">Connect with friends who run their own MyShelf. Friends can see items you mark <em>Friends only</em>, send you recommendations, comment on your notes, and ask to borrow things you own. See what they’re up to (and browse their shelves) on your <a href="/friends/">Friends page</a>.</p>
          <div class="inbox-head">
            <h3>Inbox</h3>
            <span class="inbox-head-actions">
              <button id="inbox-all-read" class="btn ghost small" type="button" data-inbox-all-read hidden>Mark all read</button>
              <button id="inbox-clear" class="btn ghost small" type="button" hidden>Clear inbox</button>
            </span>
          </div>
          <ul id="inbox-list" class="inbox-list"></ul>
          <h3>Your friends</h3>
          <ul id="friend-list" class="friend-list"></ul>
          <section id="groups-section" hidden>
            <h3>Groups</h3>
            <p class="muted small">Only you see your groups. Use them to filter your Friends page and to recommend something to everyone in a group at once.</p>
            <ul id="group-list" class="group-list"></ul>
            <div class="row">
              <button id="group-add" class="btn ghost small" type="button">＋ New group</button>
              <button id="groups-save" class="btn primary small" type="button">Save groups</button>
            </div>
          </section>
          <h3>Connect with a friend</h3>
          <div class="my-address">
            <span class="muted small">Your address — send this to friends:</span>
            <code id="my-address">…</code>
            <button type="button" class="btn ghost small" id="copy-address">Copy</button>
          </div>
          <form id="friend-add" class="row">
            <input id="friend-url" type="url" placeholder="Friend’s address, e.g. https://myshelf.alex.workers.dev" required />
            <button class="btn primary" type="submit">Add friend</button>
          </form>
          <p id="friend-msg" class="muted small"></p>
        </div>
      </div>

      <!-- Settings -->
      <div class="tabpanel" data-panel="settings" hidden>
        <div class="panel">
          <h2>Your site</h2>
          <form id="site-form" class="site-form">
            <label>Site name <input name="title" maxlength="80" required /></label>
            <label>Your name <input name="owner" maxlength="80" placeholder="Shown next to the site name (top left) and to friends" /></label>
            <label>Shelves page heading <input name="heading" maxlength="80" placeholder="Featured Shelves" /></label>
            <label>Tagline <input name="tagline" maxlength="200" placeholder="Shown under the heading" /></label>
            <label class="span2">Public address <span class="muted small">(optional — set this if you use a custom domain, so friends always reach the same address)</span>
              <input name="url" placeholder="https://myshelf.example.com" />
            </label>
            <label class="span2">Source code link <span class="muted small">(the footer’s “Source” link — if you change the code, point this at your own repository, as the AGPL license asks)</span>
              <input name="source" placeholder="https://github.com/you/myshelf" />
            </label>
            <fieldset class="span2 media-types">
              <legend>Media on your site</legend>
              <p class="muted small">Uncheck anything you don’t track. It disappears from the menu, its pages and your shelves. Nothing is deleted: check it again and it all comes back.</p>
              <div class="checks">
                {TYPE_KEYS.map((t) => <label class="check"><input type="checkbox" name="types" value={t} checked /> <span>{TYPES[t].plural}</span></label>)}
              </div>
            </fieldset>
            <fieldset class="span2 look">
              <legend>Look</legend>
              <p class="muted small">How your site looks to visitors. Anyone can still switch light or dark for themselves (bottom of the page, or the phone menu); that choice stays in their browser.</p>
              <div class="look-modes" role="radiogroup" aria-label="Light or dark">
                <label class="look-mode"><input type="radio" name="mode" value="dark" checked /> <span class="look-swatch look-dark" aria-hidden="true"></span> Dark</label>
                <label class="look-mode"><input type="radio" name="mode" value="light" /> <span class="look-swatch look-light" aria-hidden="true"></span> Light</label>
              </div>
              <div class="accent-picks" role="radiogroup" aria-label="Accent colour">
                {ACCENTS.map(([hex, name]) => (
                  <label class="accent-pick" title={name}><input type="radio" name="accent" value={hex} checked={hex === DEFAULT_ACCENT} /><span style={`--c:${hex}`} aria-hidden="true"></span><span class="sr-only">{name}</span></label>
                ))}
                <label class="accent-custom" title="Pick any colour"><input type="radio" name="accent" value="custom" /><input type="color" name="accentCustom" value="#d99a4e" aria-label="Custom accent colour" /> Custom</label>
              </div>
              <div class="look-mine">
                <label class="pref-toggle"><input type="checkbox" data-pref="mode" /> <span class="pref-track" aria-hidden="true"></span> Light mode on this browser</label>
                <span class="muted small">Just for you, here. It changes as soon as you flip it; no need to save.</span>
              </div>
            </fieldset>
            <div class="row span2"><button class="btn primary" type="submit">Save</button><span id="site-msg" class="muted small"></span></div>
          </form>
          <h2 id="api-keys">API keys</h2>
          <p class="muted">Paste the free keys for the databases MyShelf looks things up in. They’re stored encrypted on your own Cloudflare account, never shown again here (only their last four characters), and never shared with friends or put in backups. A key saved here is used instead of a Worker secret with the same name. Not sure where to get one? See <a href="https://github.com/lexjudex/myshelf#step-6-add-api-keys-for-the-media-you-track" target="_blank" rel="noopener">step-by-step instructions with links</a>.</p>
          <p id="keys-error" class="error" hidden></p>
          <div id="keys-list" class="keys-list"><p class="muted">Loading…</p></div>
          <h2>Shelf decorations</h2>
          <p class="muted">Add up to three images that stand on top of the bookcase on your main Shelves page, like a teddy bear, a mini figure, or a photo in a frame. Use PNGs with a transparent background, or put any image (a JPG, or anything with a background) in a frame. Up to 2 MB each. <strong>Drag them in the preview</strong> to place them, left, right, up or down (arrow keys nudge), or set exact numbers below. The preview shows exactly what your Shelves page will. Switch to <strong>Phone</strong> to give phones their own layout. Where they overlap, the <strong>top of the list stands in front</strong>: drag the <span aria-hidden="true">⠿</span> handle (or use ↑ ↓) to change it. Changes save as you make them.</p>
          <div class="decor-preview-bar">
            <span class="muted small" id="decor-editing"></span>
            <span class="decor-modes" role="group" aria-label="Preview size">
              <button type="button" class="btn ghost small on" data-decor-mode="desktop" aria-pressed="true">Desktop</button>
              <button type="button" class="btn ghost small" data-decor-mode="phone" aria-pressed="false">Phone</button>
            </span>
          </div>
          <!-- Your real Shelves page (/?decor-preview), at desktop or phone width, shrunk to fit: exactly what visitors see. -->
          <div class="decor-preview" id="decor-preview">
            <iframe id="decor-frame" title="Preview of your Shelves page" tabindex="-1"></iframe>
            <p class="decor-loading" id="decor-loading">Loading preview…</p>
          </div>
          <ul id="decor-list" class="decor-list"></ul>
          <div class="row">
            <label class="btn ghost file-btn" id="decor-add">＋ Add a decoration… <input id="decor-file" type="file" accept="image/png,image/webp,image/jpeg" hidden /></label>
            <span id="decor-msg" class="muted small"></span>
          </div>
          <h2 id="updates-heading">Updates</h2>
          <p id="version" class="version"></p>
          <div id="updates" class="updates"><p class="muted">Checking for a new version…</p></div>
          <div id="your-version-notes" class="your-version-notes"></div>
          <h2>Backup &amp; restore</h2>
          <p class="muted">A backup is one JSON file with all your entries, notes, collections, shelf orders and site settings. Restoring adds those to this site, replacing entries with the same name. Moving to a new site? Restore here while the old site is still online and the covers are copied over from it.</p>
          <div class="row">
            <button id="settings-export" class="btn ghost" type="button">⤓ Download backup</button>
            <label class="btn ghost file-btn">⤒ Restore from backup… <input id="restore-file" type="file" accept="application/json,.json" hidden /></label>
          </div>
          <p id="restore-msg" class="muted small"></p>
        </div>
      </div>
    </section>


    <!-- Editor (modal) -->
    <dialog id="editor" class="editor">
      <form id="editor-form" method="dialog">
        <header class="editor-head">
          <h2 id="editor-title">Add item</h2>
          <span id="editor-remembered" class="remembered" hidden>Using your last settings · <button type="button" class="linkish" id="editor-forget">Reset</button></span>
          <button type="button" class="btn ghost small" data-close>✕</button>
        </header>
        <div class="editor-grid">
          <div class="editor-cover">
            <div id="cover-preview" class="cover-preview"></div>
            <label>Cover image URL
              <input name="cover" type="text" placeholder="https://…" />
            </label>
            <p class="muted small">Remote images are copied into your shelf’s storage when you save.</p>
          </div>
          <div class="editor-fields">
            <label class="span2">Title <input name="title" required /></label>
            <label><span id="creator-label">Creator</span> <input name="creator" /></label>
            <label>Year <input name="year" inputmode="numeric" /></label>
            <label>Type
              <select name="type">{TYPE_KEYS.map((t) => <option value={t}>{TYPES[t].label}</option>)}</select>
            </label>
            <label>Status
              <select name="status" required>
                <option value="">Choose…</option>
                <option value="finished">Finished</option>
                <option value="in-progress">In progress</option>
                <option value="want">Want to</option>
                <option value="abandoned">Abandoned</option>
              </select>
            </label>
            <label data-field="rating">Rating
              <select name="rating">
                <option value="">No rating</option>
                {[5, 4.5, 4, 3.5, 3, 2.5, 2, 1.5, 1, 0.5].map((r) => <option value={r}>{'★'.repeat(Math.floor(r)) + (r % 1 ? '½' : '')} ({r})</option>)}
              </select>
            </label>
            <label data-field="dateStarted">Started <span class="date-field"><input name="dateStarted" type="date" /><button type="button" class="date-clear" data-clear-date="dateStarted" aria-label="Clear started date" title="Clear date">×</button></span></label>
            <label data-field="dateFinished">Finished <span class="date-field"><input name="dateFinished" type="date" /><button type="button" class="date-clear" data-clear-date="dateFinished" aria-label="Clear finished date" title="Clear date">×</button></span></label>
            <label>Who can see it
              <select name="visibility">
                <option value="public">Everyone</option>
                <option value="friends">Friends only</option>
                <option value="private">Only me</option>
              </select>
            </label>
            <label class="check span2" data-field="legacy"><input type="checkbox" name="legacy" /> <span>Legacy or campaign game <span class="muted small">(track how far through the campaign you are)</span></span></label>
            <fieldset class="span2 progress-field" data-field="progress">
              <legend id="progress-legend">Progress</legend>
              <div class="progress-inputs">
                <span id="progress-at-label">Page</span>
                <input name="progressAt" type="number" min="0" step="1" inputmode="numeric" aria-labelledby="progress-at-label" />
                <span>of</span>
                <input name="progressOf" type="number" min="1" step="1" inputmode="numeric" aria-label="Total" />
                <select name="progressUnit" aria-label="Counted in" hidden>
                  <option value="games">games</option><option value="chapters">chapters</option><option value="months">months</option><option value="scenarios">scenarios</option><option value="missions">missions</option>
                </select>
                <span id="progress-pct" class="muted small"></span>
              </div>
            </fieldset>
            <label class="check span2" data-field="owned"><input type="checkbox" name="owned" /> <span>I own a copy <span class="muted small">(friends can ask to borrow it)</span></span></label>
            <label data-field="lent">Lent to <input name="lentTo" placeholder="Nobody right now" /></label>
            <label data-field="lent">Lent since <span class="date-field"><input name="lentSince" type="date" /><button type="button" class="date-clear" data-clear-date="lentSince" aria-label="Clear lent date" title="Clear date">×</button></span></label>
            <fieldset class="span2">
              <legend>Collections</legend>
              <div id="editor-collections" class="checks"></div>
            </fieldset>
            <fieldset class="span2 expansions" id="editor-expansions" hidden>
              <legend>Expansions <span class="muted small" id="exp-count"></span></legend>
              <ul id="exp-list" class="exp-list"></ul>
              <div class="row exp-search">
                <input id="exp-q" type="search" placeholder="Search BGG expansions…" autocomplete="off" />
                <button type="button" class="btn ghost small" id="exp-search-btn">Search</button>
                <button type="button" class="btn ghost small" id="exp-known-btn" hidden>Show this game’s expansions</button>
                <button type="button" class="btn ghost small" id="exp-manual-btn" title="Attach the typed name without a BGG match">Add as typed</button>
              </div>
              <p id="exp-msg" class="muted small"></p>
              <ul id="exp-results" class="exp-results"></ul>
            </fieldset>
            <label>Tags <input name="tags" placeholder="comma, separated" /></label>
            <label>Genres <input name="genres" placeholder="comma, separated" /></label>
            <div class="span2 editor-takes" id="editor-takes" hidden></div>
            <label class="span2">
              <span class="label-row">My notes / journal <span class="muted small">(Markdown)</span>
                <button type="button" class="btn ghost small" id="add-entry">＋ Dated entry</button></span>
              <textarea name="body" rows="8" placeholder="What did you think? (type @ to mention a friend)" data-mentions></textarea>
            </label>
            <div class="span2 featured-field">
              <label class="check"><input type="checkbox" name="featured" /> <span><strong>Featured</strong> — show these notes in <em>My Ramblings</em> on the home page</span></label>
              <p id="featured-hint" class="muted small"></p>
            </div>
            <details class="span2">
              <summary>Description &amp; details</summary>
              <label>Description <textarea name="description" rows="4"></textarea></label>
              <label>Details <span class="muted small">(one <code>key: value</code> per line — lists comma-separated)</span>
                <textarea name="details" rows="4" placeholder="pages: 412"></textarea>
              </label>
            </details>
          </div>
        </div>
        <footer class="editor-foot">
          <span id="editor-source" class="muted small"></span>
          <button type="button" class="btn ghost small" id="editor-refresh-bgg" hidden>↻ Refresh from BGG</button>
          <span class="spacer"></span>
          <button type="button" class="btn ghost" data-close>Cancel</button>
          <button type="submit" class="btn primary" id="editor-save" value="save">Save to shelf</button>
        </footer>
      </form>
    </dialog>

    <!-- Live preview shown right after saving -->
    <dialog id="preview" class="preview">
      <div class="preview-bar">
        <span id="publish-status" class="publish-status"></span>
        <span class="spacer"></span>
        <button type="button" class="btn ghost small" id="preview-edit">Edit</button>
        <button type="button" class="btn ghost small" id="preview-another">＋ Add another</button>
        <button type="button" class="btn ghost small" data-close-preview>✕</button>
      </div>
      <div id="preview-body"></div>
    </dialog>

    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
  </div>
  <script>
    import '../../scripts/admin.js';
    import '../../scripts/friends.js';
    import '../../scripts/decor-settings.js';
    import '../../scripts/api-keys.js';
    import '../../scripts/update-banner.js';
    import { enableMentionPicker } from '../../scripts/mention-picker.js';
    enableMentionPicker();
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import Shelf from '../components/Shelf.astro';
import JournalCard from '../components/JournalCard.astro';
import CopyLink from '../components/CopyLink.astro';
import '../styles/decor.css';
import { getSite } from '../../server/site.js';
import { getDecor } from '../../server/decor.js';
import { decorStyle, decorClasses, decorInner, decorMaxStyle } from '../lib/decor.js';
import { getItems, getShelves } from '../lib/items.js';
import { sortShelf, inShelf, showsOnHome, isAutoShelf, STARTER_SHELVES, findStarter } from '../lib/sorting.js';
import ShelfEditor from '../components/ShelfEditor.astro';
import { TYPES, TYPE_KEYS } from '../lib/types.js';

const env = Astro.locals.runtime.env;
const escAttr = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
// /?decor-preview: this page as the live preview in Manage → Settings → Shelf decorations. Only the top of the
// bookcase is shown (no shelves are loaded), and the decorations come from the Settings page as you edit them.
const decorPreview = Astro.url.searchParams.has('decor-preview');
const [items, shelves, site, decor] = decorPreview
  ? [[], [], await getSite(env), await getDecor(env)]
  : await Promise.all([getItems(env), getShelves(env), getSite(env), getDecor(env)]);
// "My Ramblings": the entry marked Featured in the editor, or else the most recent journal entry
// (items are already sorted newest first).
const hasNotes = (e) => e.body && e.body.trim();
const latestThought = items.find((e) => e.data.featured === true && hasNotes(e)) || items.find(hasNotes);
// "Edit shelves" (signed in): shelves that could be put on this page.
const addable = decorPreview ? [] : [
  ...shelves.filter((s) => !showsOnHome(s)).map((s) => ({ id: `c:${s.slug}`, name: s.name, note: isAutoShelf(s) ? 'Fills itself' : 'Your collection' })),
  ...STARTER_SHELVES.filter((st) => !findStarter(shelves, st)).map((st) => ({ id: `starter:${st.key}`, name: st.label, note: st.hint })),
];
---
<Base noindex={decorPreview}>
  {decorPreview && <script is:inline>document.documentElement.classList.add('decor-preview');</script>}
  <section class="hero">
    {!decorPreview && <ShelfEditor page="home" addable={addable} />}
    <h1>{site.heading}<CopyLink label="Copy link to this shelf" /></h1>
    <p>{site.tagline}</p>
  </section>

  {/* Shelf decorations (Manage → Settings): up to three images standing on top of the bookcase. */}
  {(decor.length > 0 || decorPreview) && (
    <div class="bookcase-top" aria-hidden="true" style={decorMaxStyle(decor)}>
      {decor.map((d, i) => (
        <span class={decorClasses(d)} style={decorStyle(d, i, decor.length)} set:html={decorInner(d, escAttr)} />
      ))}
    </div>
  )}
  <div class="bookcase scroll-motion">
    {shelves.filter(showsOnHome).map((s) => {
      const list = sortShelf(items.filter((e) => inShelf(e.data, s)), s);
      return <Shelf title={s.name} description={s.description} items={list} href={`/shelf/${s.slug}/`} seeAll scroll limit={24} empty="No items on this shelf yet." collection={s.slug} shelfId={`c:${s.slug}`} kind={isAutoShelf(s) ? 'auto' : 'manual'} />;
    })}
  </div>

  {latestThought && (
    <section class="my-thoughts">
      <div class="my-thoughts-head">
        <h2>My Ramblings</h2>
      </div>
      <JournalCard entry={latestThought} clamp />
      <div class="my-thoughts-foot">
        <a class="btn-see-all" href="/journal/">See all</a>
      </div>
    </section>
  )}
</Base>

<script>
  // Keep shelf decorations inside the bookcase's width (a big one near an edge can hang off on a phone).
  import { keepInside, decorStyle, decorClasses, decorInner, decorMaxStyle } from '../lib/decor.js';
  const top = document.querySelector('.bookcase-top');
  const fit = () => keepInside(top);
  const watchImages = () => top.querySelectorAll('img').forEach((img) => { if (!img.complete) img.addEventListener('load', () => { fit(); tellSize(); }, { once: true }); });
  if (top) {
    watchImages();
    fit();
    new ResizeObserver(() => { fit(); tellSize(); }).observe(top);
  }

  // ───────── live preview for Manage → Settings (/?decor-preview, shown in a frame there) ─────────
  // The Settings page sends the decorations as you edit them; this page draws them exactly as it always does, and
  // reports drags and arrow-key nudges back. Only messages from this same site are listened to.
  function tellSize() {
    if (!document.documentElement.classList.contains('decor-preview') || window.parent === window) return;
    const r = document.querySelector('.bookcase')?.getBoundingClientRect();
    window.parent.postMessage({ type: 'myshelf:decor-size', height: Math.ceil((r?.bottom || 0) + window.scrollY) }, location.origin);
  }
  if (document.documentElement.classList.contains('decor-preview') && top) {
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const tell = (msg) => window.parent.postMessage(msg, location.origin);
    let list = [];
    let locked = true; // until Manage says otherwise: dragging does nothing while it's locked
    window.addEventListener('message', (e) => {
      if (e.origin !== location.origin || e.source !== window.parent || e.data?.type !== 'myshelf:decor') return;
      list = e.data.decor || [];
      locked = e.data.locked === true;
      top.classList.toggle('decor-locked', locked);
      top.setAttribute('style', decorMaxStyle(list));
      const els = [...top.querySelectorAll('.decor')];
      const same = els.length === list.length && els.every((el, i) => el.dataset.image === list[i].image);
      if (same) {
        // Same pictures: update them in place (keeps a drag going and keeps focus).
        els.forEach((el, i) => {
          const nudge = el.style.getPropertyValue('--nudge');
          el.className = decorClasses(list[i]) + (el.classList.contains('dragging') ? ' dragging' : '');
          el.setAttribute('style', decorStyle(list[i], i, list.length));
          if (nudge) el.style.setProperty('--nudge', nudge);
        });
      } else {
        top.innerHTML = list.map((d, i) => `<span class="${decorClasses(d)}" style="${decorStyle(d, i, list.length)}" data-i="${i}" data-image="${esc(d.image)}" tabindex="0"
          title="Unlock in Manage, then drag to move · arrow keys nudge (Shift for bigger steps)">${decorInner(d, esc)}</span>`).join('');
      }
      if (e.data.focus != null) top.querySelector(`.decor[data-i="${e.data.focus}"]`)?.focus({ preventScroll: true });
      watchImages();
      fit();
      tellSize();
    });
    // Drag: report where the middle should go, as % of the bookcase's width.
    let drag = null;
    top.addEventListener('pointerdown', (e) => {
      const el = e.target.closest('.decor[data-i]');
      if (!el || locked) return;
      e.preventDefault();
      el.focus({ preventScroll: true });
      const r = el.getBoundingClientRect();
      const y0 = parseFloat(getComputedStyle(el).getPropertyValue('--Y')) || 0;
      drag = { i: Number(el.dataset.i), el, offset: e.clientX - (r.left + r.width / 2), nudge: parseFloat(el.style.getPropertyValue('--nudge')) || 0, startY: e.clientY, y0 };
      el.setPointerCapture(e.pointerId);
      el.classList.add('dragging');
    });
    top.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const box = top.getBoundingClientRect();
      const x = ((e.clientX - drag.offset - drag.nudge - box.left) / box.width) * 100;
      // Up the screen = higher above the shelf. Ignore the first few px of up/down, so a sideways drag stays level.
      const dy = drag.startY - e.clientY;
      if (Math.abs(dy) > 6) drag.vertical = true;
      const y = drag.y0 + (drag.vertical ? dy : 0);
      tell({ type: 'myshelf:decor-move', i: drag.i, x: Math.round(Math.min(100, Math.max(0, x)) * 10) / 10, y: Math.round(y) });
    });
    const end = () => {
      if (!drag) return;
      drag.el.classList.remove('dragging');
      tell({ type: 'myshelf:decor-move', i: drag.i, done: true });
      drag = null;
    };
    top.addEventListener('pointerup', end);
    top.addEventListener('pointercancel', end);
    top.addEventListener('keydown', (e) => {
      const el = e.target.closest('.decor[data-i]');
      if (!el || locked || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) return;
      e.preventDefault();
      const horizontal = e.key === 'ArrowLeft' || e.key === 'ArrowRight';
      const sign = e.key === 'ArrowLeft' || e.key === 'ArrowDown' ? -1 : 1;
      // Left/right in % of the width (0.5, or 5 with Shift); up/down in px (1, or 10 with Shift).
      tell({ type: 'myshelf:decor-nudge', i: Number(el.dataset.i), field: horizontal ? 'x' : 'y', step: sign * (horizontal ? (e.shiftKey ? 5 : 0.5) : (e.shiftKey ? 10 : 1)) });
    });
    tell({ type: 'myshelf:decor-ready' });
  }
</script>

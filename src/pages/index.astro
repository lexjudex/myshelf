---
import Base from '../layouts/Base.astro';
import Shelf from '../components/Shelf.astro';
import JournalCard from '../components/JournalCard.astro';
import CopyLink from '../components/CopyLink.astro';
import '../styles/decor.css';
import { getSite } from '../../server/site.js';
import { getDecor } from '../../server/decor.js';
import { getItems, getShelves } from '../lib/items.js';
import { sortShelf, inShelf, showsOnHome } from '../lib/sorting.js';
import { TYPES, TYPE_KEYS } from '../lib/types.js';

const env = Astro.locals.runtime.env;
const [items, shelves, site, decor] = await Promise.all([getItems(env), getShelves(env), getSite(env), getDecor(env)]);
// "My Ramblings": the entry marked Featured in the editor, or else the most recent journal entry
// (items are already sorted newest first).
const hasNotes = (e) => e.body && e.body.trim();
const latestThought = items.find((e) => e.data.featured === true && hasNotes(e)) || items.find(hasNotes);
---
<Base>
  <section class="hero">
    <h1>{site.title}{site.owner && <span class="hero-owner"><span class="sep">|</span>{site.owner}</span>}<CopyLink label="Copy link to this shelf" /></h1>
    <p>{site.tagline}</p>
  </section>

  {/* Shelf decorations (Manage → Settings): up to three images standing on top of the bookcase. */}
  {decor.length > 0 && (
    <div class="bookcase-top" aria-hidden="true">
      {decor.map((d) => (
        <span class:list={['decor', `decor-${d.size}`, `decor-${d.position}`, { flip: d.flip, framed: d.frame !== 'none', [`frame-${d.frame}`]: d.frame !== 'none' }]}>
          <img src={d.image} alt="" decoding="async" style={d.aspect ? `aspect-ratio:${d.aspect}` : undefined} />
        </span>
      ))}
    </div>
  )}
  <div class="bookcase scroll-motion">
    {shelves.filter(showsOnHome).map((s) => {
      const list = sortShelf(items.filter((e) => inShelf(e.data, s)), s);
      return <Shelf title={s.name} description={s.description} items={list} href={`/shelf/${s.slug}/`} seeAll scroll limit={12} empty="No items on this shelf yet." collection={s.slug} />;
    })}
  </div>

  {latestThought && (
    <section class="my-thoughts">
      <div class="my-thoughts-head">
        <h2>My Ramblings</h2>
      </div>
      <JournalCard entry={latestThought} clamp />
      <div class="my-thoughts-foot">
        <a class="btn-see-all" href="/journal/">See all</a>
      </div>
    </section>
  )}
</Base>

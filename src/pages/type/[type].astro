---
import { enabledTypes } from '../../../server/site.js';
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import CopyLink from '../../components/CopyLink.astro';
import MediaFilters from '../../components/MediaFilters.astro';
import '../../styles/filters.css';
import { getItems, getShelves, getArrangements } from '../../lib/items.js';
import { getLayouts } from '../../../server/settings.js';
import ShelfEditor from '../../components/ShelfEditor.astro';
import { TYPES, TYPE_KEYS, STATUS_LABEL } from '../../lib/types.js';
import { sortShelf, inShelf, showsOnType, isAutoShelf, STARTER_SHELVES, findStarter } from '../../lib/sorting.js';

const { type } = Astro.params;
if (!TYPE_KEYS.includes(type) || !(await enabledTypes(Astro.locals.runtime.env)).includes(type)) return new Response(null, { status: 404, statusText: 'Not found' });
const env = Astro.locals.runtime.env;
const t = TYPES[type];
const [items, shelves, arrangements, layouts] = await Promise.all([getItems(env), getShelves(env), getArrangements(env), getLayouts(env)]);
const layout = layouts[type] || { order: [], hidden: [] };
const all = items.filter((e) => e.data.type === type);
// Collections shown on media pages (unless hidden on this one). One with nothing of this type is drawn hidden,
// so "Edit shelves" can still move it.
const hiddenHere = new Set(layout.hidden || []);
const typeCollections = shelves
  .filter(showsOnType)
  .map((c) => ({ id: `c:${c.slug}`, c, off: hiddenHere.has(`c:${c.slug}`), items: sortShelf(all.filter((e) => inShelf(e.data, c)), c) }));
const statuses = ['in-progress', 'finished', 'want', 'abandoned']
  .map((status) => {
    const key = `${type}:${status}`;
    const list = all.filter((e) => e.data.status === status);
    // Arranged with the pencil? Use that order (new items first); otherwise newest first.
    const items = arrangements[key] ? sortShelf(list, { sort: 'custom', order: arrangements[key] }) : list;
    return { id: `s:${status}`, status, key, label: STATUS_LABEL(type, status), items, off: hiddenHere.has(status) };
  });
// All four status shelves are always in the list: empty ones are drawn only while editing, and hidden ones stay
// there (dimmed, with Show), so nothing you hide is ever out of reach.
const groups = statuses;
// This page's own order (set with "Edit shelves"); anything not in it yet keeps the usual spot: collections, then statuses.
const pos = new Map((layout.order || []).map((id, i) => [id, i]));
const rank = (id, fallback) => (pos.has(id) ? pos.get(id) : 1000 + fallback);
const ordered = [...typeCollections.map((x, i) => ({ ...x, kind: 'c', r: rank(x.id, i) })), ...groups.map((g, i) => ({ ...g, kind: 's', r: rank(g.id, 100 + i) }))]
  .sort((a, b) => a.r - b.r);
const hasShelves = ordered.some((x) => !x.off && x.items.length);
const addable = [
  ...shelves.filter((c) => !showsOnType(c)).map((c) => ({ id: `c:${c.slug}`, name: c.name, note: isAutoShelf(c) ? 'Fills itself' : 'Your collection' })),
  ...STARTER_SHELVES.filter((st) => !findStarter(shelves, st)).map((st) => ({ id: `starter:${st.key}`, name: st.label, note: st.hint })),
];
---
<Base title={t.plural}>
  <section class="page-head">
    <p class="eyebrow">{all.length} {all.length === 1 ? t.label : t.plural}</p>
    <h1>{t.plural}<ShelfEditor page={type} addable={addable} inline /><ShelfEditor page={type} part="add" addLabel={`Add ${type === 'video' ? 'a YouTube video or channel' : /^[aeiou]/i.test(t.label) ? `an ${t.label.toLowerCase()}` : `a ${t.label.toLowerCase()}`}`} addHref={`/admin/#type=${type}`} /><CopyLink /></h1>
  </section>
  {all.length > 0 && <MediaFilters items={all} type={type} />}
  <div class="bookcase">
    {!hasShelves && <Shelf items={[]} empty={all.length ? 'No shelves on this page.' : `No ${t.plural.toLowerCase()} yet.`} />}
    {/* Status shelves work like collections: one scrolling row, with SEE ALL once there are more than 10. */}
    {ordered.map((x) => x.kind === 'c' ? (
      <Shelf title={x.c.name} description={x.c.description} items={x.off ? [] : x.items} href={`/shelf/${x.c.slug}/`} seeAll scroll collection={x.c.slug}
        height={type === 'music' ? 160 : 180} filterable shelfId={x.id} editOnly={x.items.length === 0} offPage={x.off} kind={isAutoShelf(x.c) ? 'auto' : 'manual'} empty={`No ${t.plural.toLowerCase()} on this shelf yet.`} />
    ) : (
      <Shelf title={x.label} items={x.off ? [] : x.items} href={`/type/${type}/${x.status}/`} seeAll scroll arrangeKey={x.key} height={type === 'music' ? 160 : 180} filterable shelfId={x.id} editOnly={x.items.length === 0} offPage={x.off} kind="status" />
    ))}
  </div>
</Base>

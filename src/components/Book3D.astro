---
// An item rendered as a 3D object that matches its media type:
// books, game cartridges, CD jewel cases, vinyl record sleeves, VHS boxes and board game boxes.
// Front face = cover art; side face = spine/edge with the title.
import { TYPES, isVinyl, isChannel } from '../lib/types.js';
// height = the slot (row) height; unit = the size a book is drawn at. They're the same unless the
// shelf holds board games, which get a taller row so their boxes can stand bigger than the books.
interface Props { item: any; height?: number; unit?: number; href: string; front?: boolean }
const { item, height: h = 180, href, front = false } = Astro.props;
const u = Astro.props.unit || h;
const t = TYPES[item.type] || TYPES.book;

// kind, box height (bh), front width (w) and depth (d) as fractions of a book's height (unit).
const SHAPES = {
  book:      { kind: 'book', bh: 1,    w: 2 / 3, d: 0.17, min: 14 },
  videogame: { kind: 'cart', bh: 0.92, w: 0.76, d: 0.13, min: 14 },
  music:     { kind: 'cd',   bh: 0.85, w: 0.95, d: 0.075, min: 12 },
  movie:     { kind: 'bluray', bh: 1.1,  w: 0.7,  d: 0.1,  min: 14 },
  tv:        { kind: 'vhs',  bh: 1.1,  w: 0.64, d: 0.18, min: 17 },
  boardgame: { kind: 'box',  bh: 1.25, w: 1.25, d: 0.3,  min: 24 },
  // A record sleeve: square, a good bit taller than a CD (and a book), and thin.
  vinyl:     { kind: 'vinyl', bh: 1.18, w: 1.18, d: 0.06, min: 10 },
  // YouTube: a little computer monitor on a stand (the screen is the top 78%); channels get a square screen.
  video:     { kind: 'screen', bh: 0.84, w: 1.0,  d: 0.08, min: 11 },
  channel:   { kind: 'screen', bh: 1.0,  w: 0.82, d: 0.08, min: 11 },
};
const s = (isVinyl(item) && SHAPES.vinyl) || (isChannel(item) && SHAPES.channel) || SHAPES[item.type] || SHAPES.book;
let bh = Math.round(u * s.bh);
let w = Math.round(u * s.w);
// Board game boxes come in all shapes: size the box to the cover's real proportions,
// fitting inside a max height/width (bigger than a book, like a real game box on a shelf)
// so huge boxes don't take over.
if (s.kind === 'box') {
  const a = Number(item.coverAspect) || null; // saved with the cover
  if (a) {
    const maxH = Math.min(h, u * 1.3), maxW = u * 1.65;
    let bw = maxH * a, bHt = maxH;
    if (bw > maxW) { bw = maxW; bHt = bw / a; }
    bh = Math.round(bHt);
    w = Math.round(bw);
  }
}
const d = Math.max(s.min, Math.round(u * s.d));
const spineImg = item.cover ? `url("${String(item.cover).replace(/"/g, '%22')}")` : 'none';
const label = `${item.title}${item.creator ? ' — ' + item.creator : ''}`;
const onErr = "this.closest('.book3d').classList.remove('has-cover');this.remove();";
---
<a
  href={href}
  class:list={['book3d', `kind-${s.kind}`, { 'is-front': front, 'has-cover': !!item.cover }]}
  data-type={item.type}
  data-kind={isChannel(item) ? 'channel' : undefined}
  title={label}
  aria-label={label}
  style={`--h:${h}px; --u:${u}px; --bh:${bh}px; --w:${w}px; --d:${d}px; --h0:${h}px; --u0:${u}px; --bh0:${bh}px; --w0:${w}px; --d0:${d}px; --tc:${t.color}; --spine-img:${spineImg}`}
>
  <span class="b3-box" aria-hidden="true">
    <span class="b3-front">
      {s.kind === 'screen' ? (
        <>
          <span class="mon-screen">
            {item.cover && <img src={item.cover} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror={onErr} />}
            <span class="b3-ph">
              <span class="b3-ph-title">{item.title}</span>
              {item.creator && <span class="b3-ph-creator">{item.creator}</span>}
            </span>
            <span class="mon-glare"></span>
          </span>
          <span class="mon-neck"></span>
          <span class="mon-foot"></span>
        </>
      ) : s.kind === 'cart' ? (
        <span class="cart-label">
          {item.cover && <img src={item.cover} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror={onErr} />}
          <span class="b3-ph"><span class="b3-ph-title">{item.title}</span></span>
        </span>
      ) : (
        <>
          {item.cover && <img src={item.cover} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror={onErr} />}
          <span class="b3-ph">
            <span class="b3-ph-title">{item.title}</span>
            {item.creator && <span class="b3-ph-creator">{item.creator}</span>}
          </span>
        </>
      )}
      <span class="b3-gloss"></span>
      {s.kind === 'vhs' && <span class="vhs-notch"></span>}
      {s.kind === 'bluray' && <span class="br-band"></span>}
    </span>
    <span class="b3-spine">
      {s.kind === 'cart' ? (
        <span class="cart-end-label"><span class="b3-spine-title">{item.title}</span></span>
      ) : s.kind === 'vhs' ? (
        <span class="vhs-label"><span class="b3-spine-title">{item.title}</span></span>
      ) : s.kind === 'bluray' ? (
        <span class="br-spine-title b3-spine-title">{item.title}</span>
      ) : (
        <>
          <span class="b3-spine-title">{item.title}</span>
          {item.creator && d >= 24 && s.kind !== 'box' && <span class="b3-spine-creator">{item.creator}</span>}
        </>
      )}
    </span>
  </span>
</a>

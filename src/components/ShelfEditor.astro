---
// "Edit shelves": rearrange, add and remove whole shelves right on the page (Shelves page and media pages).
// Only shown to you, in a browser signed in to Manage. See src/scripts/page-shelves.js.
// addable: shelves that could be put on this page: [{ id: 'c:<slug>' | 's:<status>' | 'starter:<key>', name, note }]
import '../styles/page-shelves.css';
// inline (media pages): a small round ✎ (edit shelves) right after the title.
// part="add" draws just the ＋ (add one of these), which goes after the ✎ and before the copy-link icon.
// addLabel/addHref: what the ＋ adds, e.g. "Add a book" → /admin/#type=book (the Journal's goes to /admin/#new).
// Both only show when you're signed in.
interface Props { page: string; addable?: { id: string; name: string; note?: string }[]; inline?: boolean; addLabel?: string; addHref?: string; part?: string }
const { page, addable = [], inline = false, addLabel = '', addHref = '', part = '' } = Astro.props;
const PENCIL = '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>';
---
{part === 'add' ? (
  <a class="shelf-edit pshelf-add-item pshelf-reveal" href={addHref} aria-label={addLabel} title={addLabel} hidden>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  </a>
) : inline ? (
  <span class="pshelf-tools pshelf-inline" data-shelves-page={page} data-addable={JSON.stringify(addable)} hidden>
    <button type="button" class="shelf-edit pshelf-start" aria-label="Edit shelves on this page" title="Edit shelves on this page">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PENCIL} />
    </button>
  </span>
) : (
  <div class="pshelf-tools" data-shelves-page={page} data-addable={JSON.stringify(addable)} hidden>
    <button type="button" class="pshelf-start">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/><path d="M18 15v6M15 18h6"/></svg>
      Edit shelves
    </button>
  </div>
)}
<script>
  import '../scripts/page-shelves.js';
</script>

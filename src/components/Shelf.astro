---
import Book3D from './Book3D.astro';
import { filterData } from '../lib/filters.js';
import { isVinyl } from '../lib/types.js';
import '../styles/shelf3d.css';
import '../styles/arrange.css';
// shelfId ('c:<collection>' or 's:<status>'): lets "Edit shelves" on the page move or remove this shelf.
// editOnly: drawn hidden, shown only while editing (an empty collection on a media page).
// offPage: hidden on this page with "Edit shelves"; drawn hidden and listed (dimmed, with Show) while editing.
interface Props { offPage?: boolean; items: any[]; title?: string; href?: string; description?: string; scroll?: boolean; limit?: number; height?: number; empty?: string; collection?: string; arrangeKey?: string; filterable?: boolean; seeAll?: boolean; shelfId?: string; editOnly?: boolean; kind?: string }
const { items, title, href, description, scroll = false, limit, height = 180, empty = 'Nothing here yet.', collection, arrangeKey, filterable = false, seeAll = false, shelfId, editOnly = false, kind, offPage = false } = Astro.props;
const editable = Boolean(collection || arrangeKey);
// SEE ALL only appears once a collection has more than 10 items.
const showSeeAll = seeAll && href && items.length > 10;
const shown = limit ? items.slice(0, limit) : items;
// When a limit hides some items, the shelf ends with a "+N more" card linking to the full collection.
const hiddenCount = items.length - shown.length;
// Some things stand taller than books (movies/TV ~1.1x, vinyl sleeves ~1.2x, board game boxes up to 1.3x),
// so the row grows to fit the tallest type on the shelf, with a little headroom.
const ROW_SCALE = { boardgame: 1.35, movie: 1.15, tv: 1.15 };
const scaleOf = (d) => (isVinyl(d) ? 1.22 : ROW_SCALE[d.type] || 1);
const rowHeight = Math.round(height * Math.max(1, ...shown.map((e) => scaleOf(e.data))));
// Row height without board games (0 if it's all board games): used when phones draw boxes smaller.
const others = shown.filter((e) => e.data.type !== 'boardgame');
const rowHeightNoBoxes = others.length ? Math.round(height * Math.max(1, ...others.map((e) => scaleOf(e.data)))) : 0;
---
<section class:list={['shelf-section', { 'shelf-edit-only': editOnly || offPage }]} data-shelf-id={shelfId} data-shelf-title={shelfId ? title : undefined} data-shelf-kind={kind} data-off-page={offPage ? '' : undefined} hidden={editOnly || offPage}>
  {title && (
    <div class="shelf-head">
      <h2>{href ? <a href={href}>{title}</a> : title}</h2>
      <span class="count"><span class="count-n">{items.length}</span>{showSeeAll && <><span class="count-sep" aria-hidden="true">|</span><a class="count-link" href={href}>See all</a></>}</span>
      {editable && (
        <button type="button" class="shelf-edit" data-collection={collection} data-arrange-key={arrangeKey} hidden aria-label={`Arrange ${title}`} title="Arrange this shelf">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </button>
      )}
      {href && !seeAll && items.length > shown.length && <a class="see-all" href={href}>See all →</a>}
    </div>
  )}
  {description && <p class="shelf-desc">{description}</p>}
  <div class:list={['shelf', 'shelf-3d', { 'shelf-scroll': scroll }]} style={`--h:${rowHeight}px; --h0:${rowHeight}px; --hb:${rowHeightNoBoxes}px`} data-collection={collection} data-arrange-key={arrangeKey}>
    {shown.length === 0 && <p class="shelf-empty">{empty}</p>}
    {shown.map((e, i) => (
      <div class="shelf-slot" data-f={filterable ? JSON.stringify(filterData(e.data)) : undefined}>
        <Book3D item={e.data} height={rowHeight} unit={height} href={`/item/${e.id}/`} front={i === 0} />
      </div>
    ))}
    {href && hiddenCount > 0 && (
      <a class="shelf-more" href={href} aria-label={`See all ${items.length} items in ${title || 'this collection'}`}>
        <span class="shelf-more-card"><span class="shelf-more-n">+{hiddenCount}</span><span class="shelf-more-label">more</span></span>
      </a>
    )}
  </div>
</section>

<script>
  import '../scripts/shelf3d.js';
  import '../scripts/edit-shelves.js';
</script>

// MyShelf runs as one Cloudflare Worker: the Astro server code plus static files (CSS, JS, fonts).
// The "Deploy to Cloudflare" button reads this file, creates the D1 database and KV namespace below
// on the new owner's account, and writes their IDs back into their copy of the repo.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myshelf",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  // nodejs_compat: some libraries expect Node built-ins.
  // global_fetch_strictly_public: lets two MyShelf Workers on the same Cloudflare account reach each other
  // over their public URLs (handy for testing friends features with a second copy).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Turn on the free myshelf.<subdomain>.workers.dev address on every deploy, so a new site
  // doesn't come up with "No URL enabled". (A brand-new account still picks its subdomain once.)
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "myshelf" }
  ],
  "kv_namespaces": [
    { "binding": "COVERS" }
  ],
  // Branch builds (pull requests) deploy a Preview with `wrangler preview`, which needs this block. It's empty on
  // purpose: Previews get no database or cover storage, so a test branch can never touch your real shelf.
  // (Pages on a Preview say storage isn't connected; that's expected. Production deploys ignore this block.)
  "previews": {},
  // Keep variables you add in the Cloudflare dashboard when the site redeploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}

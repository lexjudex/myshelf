# Secrets for your MyShelf. The "Deploy to Cloudflare" button asks for each of these.
# For local testing, copy this file to .dev.vars and fill it in. Never commit .dev.vars.
ADMIN_TOKEN=change-me # your admin password
TMDB_TOKEN= # movies + TV (optional)
TWITCH_CLIENT_ID= # video games via IGDB (optional)
TWITCH_CLIENT_SECRET= # video games via IGDB (optional)
BGG_TOKEN= # board games (optional)
SPOTIFY_CLIENT_ID= # music (optional)
SPOTIFY_CLIENT_SECRET= # music (optional)
YOUTUBE_API_KEY= # YouTube search + channel links (optional; video links work without it)
GOOGLE_BOOKS_KEY= # optional
CONTACT_EMAIL= # optional
GITHUB_TOKEN= # optional: lets Manage → Settings → Updates sync your fork
